# Exact Online OAuth Configuration
EXACT_CLIENT_ID=your_exact_online_client_id
EXACT_CLIENT_SECRET=your_exact_online_client_secret
EXACT_REDIRECT_URI=http://localhost:3000/auth/callback
EXACT_REGION=nl

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your-secure-random-session-key

# Optional: Logging
LOG_LEVEL=debug

# Dynamics 365 Business Central (Microsoft Entra app registration)
# The app registration must be enabled under "Microsoft Entra Applications"
# in every Business Central environment, with the D365 BUS FULL ACCESS
# permission set, and admin consent granted by a Global Admin.
BC_TENANT_ID=your_microsoft_entra_tenant_id
BC_CLIENT_ID=your_app_registration_client_id
BC_CLIENT_SECRET=your_app_registration_client_secret
BC_ENVIRONMENTS=ProductionDE,ProductionAT,ProductionBE,ProductionCH,ProductionDK,ProductionES,ProductionFR,ProductionGB,ProductionIT,ProductionNL,ProductionNO,ProductionPT

